# URL pública del sitio (canonical, Open Graph, sitemap y robots)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase — Project Settings > API (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Supabase CLI — solo servidor/CLI, nunca con prefijo NEXT_PUBLIC_.
# El CLI las lee de `supabase/.env` o del entorno al correr `supabase start`.
# Google Cloud Console > APIs & Services > Credentials (OAuth client ID)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
# GitHub > Settings > Developer settings > OAuth Apps
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=""
