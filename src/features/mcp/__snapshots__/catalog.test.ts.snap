              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Cuenta por defecto a la que llega. null = ninguna.",
        },
        "amount": {
          "description": "Monto de cada pago, positivo. En quincenal, el de cada quincena.",
          "type": "number",
        },
        "category": {
          "description": "Nombre de la categoría, si no tienes el id.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "category_id": {
          "description": "Categoría de ingreso (de list_categories).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "day_of_month": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
          "description": "Monthly, yearly: día de pago (1–31). Biweekly: primer día (por defecto 15).",
        },
        "day_of_week": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
          "description": "Weekly: día de la semana, 1 = lunes … 7 = domingo.",
        },
        "ends_on": {
          "anyOf": [
            {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Hasta cuándo aplica, YYYY-MM-DD. null = sin fin.",
        },
        "frequency": {
          "description": "weekly, biweekly (quincenal), monthly, yearly, daily, every_n_days o none (sin fecha fija).",
          "enum": [
            "weekly",
            "biweekly",
            "monthly",
            "yearly",
            "daily",
            "every_n_days",
            "none",
          ],
          "type": "string",
        },
        "interval_days": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
          "description": "Every_n_days: cada cuántos días (2–90), contados desde starts_on.",
        },
        "month_of_year": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
          "description": "Yearly: mes de pago (1–12).",
        },
        "name": {
          "description": "Nombre (1–60 caracteres): Salario, Arriendo…",
          "type": "string",
        },
        "recurring_income": {
          "description": "Nombre del ingreso fijo, si no tienes el id.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "recurring_income_id": {
          "description": "Id del ingreso fijo (de list_recurring).",
